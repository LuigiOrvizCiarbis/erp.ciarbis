# ─────────────────────────────────────────────────────────────
#  BIMS ERP — Variables de entorno
#  Copiar como .env y completar los valores
# ─────────────────────────────────────────────────────────────

# Base de datos (Railway PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/bimserp?schema=public"

# JWT — generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="cambiar-esto-en-produccion-minimo-32-caracteres"
JWT_EXPIRES="7d"

# Servidor
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# CORS — URLs del frontend separadas por coma
CORS_ORIGIN=http://localhost:3000,https://erp.ciarbis.com

# Email (SMTP de la casilla de Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-responder@ciarbis.com
SMTP_PASS=
EMAIL_FROM=no-responder@ciarbis.com

# URL pública del sitio — se usa para armar los links de los emails (confirmar cuenta, reset de password)
APP_URL=https://erp.ciarbis.com

# WhatsApp Business API
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=

# Storage (Cloudflare R2 / AWS S3)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=bimserp

# Sentry (monitoreo de errores)
SENTRY_DSN=

# ARCA/AFIP (facturación electrónica)
AFIP_CUIT=
AFIP_ENV=testing
